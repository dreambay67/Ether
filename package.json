{
  "name": "ether",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @ether/providers build && pnpm --filter @ether/graph-kernel build && pnpm --filter @ether/document build && pnpm --filter @ether/execution build && pnpm --filter @ether/application build && pnpm --filter @ether/engine build && pnpm --filter @ether/mcp-server build && pnpm --filter @ether/desktop build",
    "test": "pnpm --filter @ether/application build && pnpm --filter @ether/engine build && pnpm --filter @ether/mcp-server build && pnpm --filter @ether/codex-plugin validate && pnpm run test:unit && pnpm run test:integration && pnpm --filter @ether/testing test:contracts && pnpm run test:smoke",
    "test:unit": "pnpm --filter @ether/testing test:unit",
    "test:integration": "pnpm --filter @ether/testing test:integration",
    "test:packaged": "pnpm --filter @ether/testing test:packaged",
    "test:performance": "pnpm --filter @ether/testing test:performance",
    "test:conformance:codex": "pnpm --filter @ether/testing test:conformance:codex",
    "test:conformance:antigravity": "pnpm --filter @ether/testing test:conformance:antigravity",
    "test:smoke": "pnpm --filter @ether/testing test:smoke",
    "acceptance:smoke": "pnpm --filter @ether/testing test:acceptance",
    "test:acceptance": "pnpm run acceptance:smoke",
    "desktop:dev": "pnpm --filter @ether/desktop dev",
    "desktop:build": "pnpm --filter @ether/desktop build",
    "desktop:package:win": "pnpm desktop:build && node scripts/package-windows.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^36.4.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  }
}
