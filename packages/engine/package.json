{
  "name": "@ether/engine",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graph/artifacts": {
      "types": "./dist/graph/artifacts.d.ts",
      "default": "./dist/graph/artifacts.js"
    },
    "./graph/canvasGeometry": {
      "types": "./dist/graph/canvasGeometry.d.ts",
      "default": "./dist/graph/canvasGeometry.js"
    },
    "./graph/connectionRules": {
      "types": "./dist/graph/connectionRules.d.ts",
      "default": "./dist/graph/connectionRules.js"
    },
    "./graph/contracts": {
      "types": "./dist/graph/contracts.d.ts",
      "default": "./dist/graph/contracts.js"
    },
    "./graph/nodeCatalog": {
      "types": "./dist/graph/nodeCatalog.d.ts",
      "default": "./dist/graph/nodeCatalog.js"
    },
    "./graph/promptAssembly": {
      "types": "./dist/graph/promptAssembly.d.ts",
      "default": "./dist/graph/promptAssembly.js"
    },
    "./graph/reviewRouterTemplate": {
      "types": "./dist/graph/reviewRouterTemplate.d.ts",
      "default": "./dist/graph/reviewRouterTemplate.js"
    },
    "./graph/textMutation": {
      "types": "./dist/graph/textMutation.d.ts",
      "default": "./dist/graph/textMutation.js"
    },
    "./run/execution": {
      "types": "./dist/run/execution.d.ts",
      "default": "./dist/run/execution.js"
    },
    "./run/rerunState": {
      "types": "./dist/run/rerunState.d.ts",
      "default": "./dist/run/rerunState.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @ether/providers build && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ether/providers": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
