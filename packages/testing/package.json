{
  "name": "@ether/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretypecheck": "pnpm --filter @ether/application build && pnpm --filter @ether/mcp-server build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "pretest:unit": "pnpm --filter @ether/schema build && pnpm --filter @ether/graph-kernel build",
    "test:unit": "vitest run --config vitest.config.ts",
    "pretest:integration": "pnpm --filter @ether/providers build && pnpm --filter @ether/application build && pnpm --filter @ether/mcp-server build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretest:performance": "pnpm --filter @ether/schema build",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "pretest:contracts": "pnpm --filter @ether/providers build",
    "test:contracts": "cross-env ETHER_TEST_SUITE=contracts vitest run --config vitest.integration.config.ts",
    "pretest:conformance:codex": "pnpm --filter @ether/providers build && pnpm --filter @ether/schema build",
    "test:conformance:codex": "cross-env ETHER_TEST_SUITE=conformance:codex vitest run --config vitest.integration.config.ts",
    "pretest:conformance:antigravity": "pnpm --filter @ether/providers build && pnpm --filter @ether/schema build",
    "test:conformance:antigravity": "cross-env ETHER_TEST_SUITE=conformance:antigravity vitest run --config vitest.integration.config.ts",
    "test:smoke": "playwright test --config playwright.config.ts",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:packaged": "playwright test --config playwright.packaged.config.ts",
    "test:acceptance": "pnpm --workspace-root test:acceptance"
  },
  "dependencies": {
    "@ether/application": "workspace:*",
    "@ether/brand": "workspace:*",
    "@ether/document": "workspace:*",
    "@ether/execution": "workspace:*",
    "@ether/graph-kernel": "workspace:*",
    "@ether/intelligence": "workspace:*",
    "@ether/providers": "workspace:*",
    "@ether/schema": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
