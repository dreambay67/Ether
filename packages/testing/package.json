{
  "name": "@ether/testing",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretypecheck": "pnpm --filter @ether/application build && pnpm --filter @ether/mcp-server build && pnpm --filter @ether/intelligence build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "pretest:unit": "pnpm --filter @ether/schema build && pnpm --filter @ether/graph-kernel build",
    "test:unit": "vitest run --config vitest.config.ts",
    "pretest:integration": "pnpm --filter @ether/providers build && pnpm --filter @ether/application build && pnpm --filter @ether/mcp-server build && pnpm --filter @ether/intelligence build && pnpm --filter @ether/desktop build && node ../../scripts/create-installer-assets.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretest:destructive-chaos": "pnpm --filter @ether/providers build && pnpm --filter @ether/application build && pnpm --filter @ether/mcp-server build && pnpm --filter @ether/intelligence build",
    "test:destructive-chaos": "cross-env ETHER_TEST_SUITE=destructive-chaos vitest run --config vitest.integration.config.ts",
    "pretest:performance": "node ../../node_modules/electron/install.js && pnpm --filter @ether/schema build && pnpm --filter @ether/document build && pnpm --filter @ether/providers build && pnpm --filter @ether/application build && pnpm --filter @ether/mcp-server build",
    "test:performance": "vitest run --config vitest.performance.config.ts && playwright test --config playwright.performance.config.ts",
    "pretest:contracts": "pnpm --filter @ether/providers build",
    "test:contracts": "cross-env ETHER_TEST_SUITE=contracts vitest run --config vitest.integration.config.ts",
    "pretest:conformance:codex": "pnpm --filter @ether/providers build && pnpm --filter @ether/schema build",
    "test:conformance:codex": "cross-env ETHER_TEST_SUITE=conformance:codex vitest run --config vitest.integration.config.ts",
    "pretest:conformance:antigravity": "pnpm --filter @ether/providers build && pnpm --filter @ether/schema build",
    "test:conformance:antigravity": "cross-env ETHER_TEST_SUITE=conformance:antigravity vitest run --config vitest.integration.config.ts",
    "test:smoke": "playwright test --config playwright.config.ts",
    "test:recovery-driver": "vitest run --config vitest.config.ts tests/recovery-journey-driver.test.ts",
    "test:recovery-baseline:source": "cross-env ETHER_RECOVERY_BASELINE_MODE=source-electron playwright test --config playwright.recovery-baseline.config.ts",
    "test:recovery-baseline:packaged": "cross-env ETHER_RECOVERY_BASELINE_MODE=packaged playwright test --config playwright.recovery-baseline.config.ts",
    "test:document-lifecycle-recovery:source": "cross-env ETHER_DOCUMENT_LIFECYCLE_MODE=source-electron playwright test --config playwright.document-lifecycle-recovery.config.ts",
    "test:document-lifecycle-recovery:packaged": "cross-env ETHER_DOCUMENT_LIFECYCLE_MODE=packaged playwright test --config playwright.document-lifecycle-recovery.config.ts",
    "test:visible-recovery:packaged": "playwright test --config playwright.visible-recovery-packaged.config.ts",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:packaged": "playwright test --config playwright.packaged.config.ts",
    "test:acceptance": "pnpm --workspace-root test:acceptance"
  },
  "dependencies": {
    "@ether/application": "workspace:*",
    "@ether/brand": "workspace:*",
    "@ether/document": "workspace:*",
    "@ether/execution": "workspace:*",
    "@ether/graph-kernel": "workspace:*",
    "@ether/intelligence": "workspace:*",
    "@ether/providers": "workspace:*",
    "@ether/schema": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
