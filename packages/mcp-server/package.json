{
  "name": "@ether/mcp-server",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./bridge": "./dist/bridge.js"
  },
  "bin": {
    "ether-mcp-server": "dist/index.js"
  },
  "scripts": {
    "prebuild": "pnpm --filter @ether/application build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @ether/application build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@ether/application": "workspace:*",
    "@ether/schema": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.32"
  }
}
